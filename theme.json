{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"custom": {
			"lineHeight": "calc(4px + 2ex)",
			"transitionTiming": "ease-in-out",
			"transitionDuration": "0.15s",
			"transition": "var(--wp--preset--transition--timing) var(--wp--preset--transition--duration)"
		},
		"layout": {
			"contentSize": "840px",
			"wideSize": "1200px"
		},
		"color": {
			"palette": [
				{
					"slug": "primary",
					"color": "#00ae83",
					"name": "Primary Green"
				},
				{
					"slug": "primary-dark",
					"color": "#00644b",
					"name": "Dark Green"
				},
				{
					"slug": "academy-green",
					"color": "#2e3636",
					"name": "Academy Green"
				},
				{
					"slug": "spark-yellow",
					"color": "#f4c063",
					"name": "Spark Yellow"
				},
				{
					"slug": "ar-purple",
					"color": "#9d9dcd",
					"name": "Above Reproach Purple"
				},
				{
					"slug": "ar-orange",
					"color": "#e37f5a",
					"name": "Above Reproach Orange"
				},
				{
					"slug": "ar-yellow",
					"color": "#f4eb27",
					"name": "Above Reproach Yellow"
				},
				{
					"slug": "grey",
					"color": "#4b4b4b",
					"name": "Grey"
				},
				{
					"slug": "grey-light",
					"color": "#707070",
					"name": "Light Grey"
				},
				{
					"slug": "grey-lightest",
					"color": "#dbdbdb",
					"name": "Super Light Grey"
				},
				{
					"slug": "white",
					"color": "#fff",
					"name": "White"
				},
				{
					"slug": "black",
					"color": "#000",
					"name": "Black"
				},
				{
					"slug": "drop-shadow",
					"color": "rgba(0,0,0,.35)",
					"name": "Drop Shadow"
				}
			],
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": true
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"fontFamily": "'Roie', sans-serif;",
					"name": "Roie",
					"slug": "roie",
					"fontFace": [
						{
							"fontFamily": "Roie",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": ["file:./assets/fonts/roie/Roie.ttf"]
						}
					]
				},
				{
					"fontFamily": "'Poppins', sans-serif;",
					"name": "Poppins",
					"slug": "poppins",
					"fontFace": [
						{
							"fontFamily": "Poppins",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/poppins/Poppins-Regular.ttf"
							]
						},
						{
							"fontFamily": "Poppins",
							"fontStyle": "normal",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/poppins/Poppins-Bold.ttf"
							]
						},
						{
							"fontFamily": "Poppins",
							"fontStyle": "italic",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/poppins/Poppins-Italic.ttf"
							]
						},
						{
							"fontFamily": "Poppins",
							"fontStyle": "italic",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/poppins/Poppins-BoldItalic.ttf"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "1.4rem",
					"name": "Small"
				},
				{
					"slug": "medium",
					"size": "1.6rem",
					"name": "Medium"
				},
				{
					"slug": "large",
					"size": "2.4rem",
					"name": "Large"
				},
				{
					"slug": "x-large",
					"size": "3.2rem",
					"name": "Extra Large"
				},
				{
					"slug": "huge",
					"size": "4.8rem",
					"name": "Huge"
				}
			]
		}
	},
	"styles": {
		"blocks": {
			"core/button": {
				"color": {
					"text": "white",
					"background": "var(--wp--preset--color--primary)"
				}
			}
		}
	}
}
